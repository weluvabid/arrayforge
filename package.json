{
  "name": "@arrayforge/core",
  "version": "0.1.0",
  "description": "Persistent vectors for large JavaScript and TypeScript datasets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:package",
    "precommit": "pnpm check",
    "bench": "node --experimental-strip-types src/cli.ts",
    "bench:smoke": "node --experimental-strip-types src/cli.ts --size 10000 --rounds 3 --warmup 1 --iterations 10",
    "bench:browser": "vite --config benchmarks/browser/vite.config.ts --host 127.0.0.1",
    "bench:browser:build": "vite build --config benchmarks/browser/vite.config.ts",
    "bench:trees": "node --experimental-strip-types src/cli.ts --sizes 100000,1000000 --adapter bplus-256,rrb-256,bplus-512,rrb-512,bplus-1024,rrb-1024 --rounds 11 --warmup 3 --target-ms 25",
    "bench:trees:large": "node --experimental-strip-types src/cli.ts --sizes 5000000 --adapter bplus-256,rrb-256,bplus-512,rrb-512,bplus-1024,rrb-1024 --rounds 11 --warmup 3 --target-ms 25",
    "bench:structural": "node --expose-gc --experimental-strip-types scripts/benchmark-structural-ops.mjs",
    "profile:trees": "node --expose-gc --experimental-strip-types scripts/profile-trees.mjs",
    "profile:trees:large": "node --expose-gc --experimental-strip-types scripts/profile-trees.mjs --size 5000000 --updates 20000 --snapshots 64",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/rewrite-declarations.mjs",
    "prepack": "npm run build",
    "verify:package": "npm pack --dry-run",
    "bench:churn": "node --experimental-strip-types src/cli.ts --sizes 100000,1000000,5000000,10000000 --adapter bplus-256,rrb-256 --workload mutation-churn --rounds 7 --warmup 2 --iterations 20000 --format json --output docs/benchmarks/results/mutation-churn.json",
    "bench:scale": "node --experimental-strip-types src/cli.ts --sizes 100000,1000000,5000000,10000000 --adapter bplus-256,rrb-256 --rounds 7 --warmup 2 --target-ms 25 --format json --output docs/benchmarks/results/scale-validation.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^26.0.0",
    "daisyui": "^5.0.50",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "immer": "^10.1.1",
    "immutable": "^5.1.4",
    "mutative": "^1.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/api.md",
    "docs/performance.md",
    "docs/benchmarking.md",
    "docs/architecture/",
    "docs/benchmarks/independent-tree-evaluation.md",
    "docs/benchmarks/results/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "keywords": [
    "persistent data structures",
    "persistent vector",
    "immutable collections",
    "javascript",
    "typescript"
  ]
}
